# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/
.history/
.codemap/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

/example/
flexi_kline_indicators/
.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
# 根目录 workspace lockfile 与成员包的 lockfile 均不入库。
/pubspec.lock
packages/*/pubspec.lock
apps/*/pubspec.lock
**/doc/api/
.dart_tool/
build/

# workspace 临时脱离用的 pubspec_overrides.yaml 不得入库（§3.3 逃生口）
packages/*/pubspec_overrides.yaml
apps/*/pubspec_overrides.yaml

# FVM Version Cache
.fvm/

# Local device lists for tool/benchmark/matrix.sh (devices.conf and variants; the example stays tracked)
/tool/benchmark/devices*.conf
!/tool/benchmark/devices.example.conf

# Worktrees (benchmark baseline in .worktrees/benchmark/, development trees)
/.worktrees/
